@{
	ViewData["Tittle"] = "Proveedor";
}

@model IEnumerable<Proveedor>

<h1>@ViewData["Tittle"]</h1>
<div class="container">
	<h2>Registro de Proveedor</h2>

    <form id="proveedorForm" asp-action="IngresarProv" method="POST">

        <label for="nombreProveedor">Nombre del Proveedor:</label>
        <input type="text" id="nombreProveedor" name="nombreProveedor" required>

        <label for="contactoProveedor">Contacto (Celular):</label>
        <input type="number" id="contactoProveedor" name="contactoProveedor" required>

        <button type="submit" class = "btn btn-primary mb-3">Guardar Proveedor</button>
    </form>
</div>

<div class="container">
    <h2>Listado de Proveedores</h2>
    <table id="tablaProveedores" class="table align-items-center text-center table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Contacto (Celular)</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.idProveedor</td>
					<td>@p.nombreProveedor</td>
					<td>@p.contactoProveedor</td>
                    <td>
                        <button type="button" class="btn btn-warning">Editar</button>
                        <button onclick="eliminarProv(@p.idProveedor)" class="btn btn-danger">Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script src="~/js/proveedor.js"></script>
